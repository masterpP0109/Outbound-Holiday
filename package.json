{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && tsx scripts/prerender.tsx",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts server shared prisma tests vite.config.ts eslint.config.js",
    "check:seo": "tsx scripts/check-seo.ts",
    "check:contacts": "tsx scripts/check-contacts.tsx",
    "postinstall": "prisma generate",
    "dev:api": "tsx watch server/index.ts",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reconcile": "tsx prisma/seed.ts --check",
    "db:studio": "prisma studio",
    "test:backend": "tsx --test tests/*.test.ts",
    "outbox:run": "tsx scripts/outbox.ts",
    "content:export": "tsx scripts/export-content.ts",
    "dev:db": "tsx scripts/local-postgres.ts",
    "build:api": "tsup server/index.ts scripts/outbox.ts prisma/seed.ts scripts/validate-container.ts --format esm --platform node --target node22 --out-dir backend-dist --clean --splitting",
    "start:api": "node backend-dist/server/index.js",
    "content:apply": "tsx scripts/apply-content.ts",
    "outbox:production": "node backend-dist/scripts/outbox.js",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:outage": "node scripts/browser-outage.mjs",
    "docker:build": "docker build --platform linux/amd64 -t outbound-holidays-api:local .",
    "docker:run": "node scripts/docker-run.mjs",
    "images:upload": "tsx scripts/upload-webp.ts",
    "test:images": "tsx --test tests/upload-images.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@neon/config": "^1.8.4",
    "@neon/env": "^1.5.1",
    "@prisma/client": "^6.19.3",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^10.0.16",
    "prisma": "^6.19.3",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.2",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "tailwindcss": "^4.1.14",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.2.3"
  }
}
