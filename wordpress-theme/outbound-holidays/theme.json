{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "1200px",
      "wideSize": "1440px"
    },
    "color": {
      "defaultPalette": false,
      "palette": [
        { "slug": "vf-blue", "color": "#0B5E8E", "name": "Victoria Falls Blue" },
        { "slug": "vf-deep", "color": "#0D2833", "name": "Zambezi Deep Navy" },
        { "slug": "golden-savannah", "color": "#C9A66B", "name": "Golden Savannah" },
        { "slug": "zambezi-green", "color": "#3F6B3C", "name": "Zambezi Green" },
        { "slug": "sunset-orange", "color": "#E67E22", "name": "Sunset Orange" },
        { "slug": "charcoal-grey", "color": "#2F3A44", "name": "Charcoal Grey" },
        { "slug": "cream-canvas", "color": "#FAF9F6", "name": "Safari Cream" },
        { "slug": "warm-ivory", "color": "#FDFBF7", "name": "Warm Ivory" },
        { "slug": "whatsapp-green", "color": "#25D366", "name": "WhatsApp Green" },
        { "slug": "white", "color": "#FFFFFF", "name": "White" }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "fontFamilies": [
        {
          "fontFamily": "\"Cormorant Garamond\", Georgia, serif",
          "slug": "serif",
          "name": "Cormorant Garamond (Editorial Serif)"
        },
        {
          "fontFamily": "\"Manrope\", -apple-system, BlinkMacSystemFont, sans-serif",
          "slug": "sans",
          "name": "Manrope (UI Sans)"
        }
      ],
      "fontSizes": [
        { "slug": "xs", "size": "0.75rem", "name": "XS" },
        { "slug": "sm", "size": "0.875rem", "name": "SM" },
        { "slug": "base", "size": "1rem", "name": "Base" },
        { "slug": "lg", "size": "1.125rem", "name": "LG" },
        { "slug": "xl", "size": "1.25rem", "name": "XL" },
        { "slug": "2xl", "size": "1.5rem", "name": "2XL" },
        { "slug": "3xl", "size": "1.875rem", "name": "3XL" },
        { "slug": "4xl", "size": "2.5rem", "name": "4XL" },
        { "slug": "5xl", "size": "3.25rem", "name": "5XL" }
      ]
    }
  }
}
