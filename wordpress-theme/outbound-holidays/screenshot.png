<body class="error404 wp-theme-outbound-holidays">
<header class="site-header">
    <div class="topbar">
        <div class="container topbar-inner">
            <span>Outbound Holiday</span>
            <div class="topbar-links">
                <a href="https://outboundholiday.com/contact/">Plan my trip</a>
                <a href="tel:+263 13 456 789">+263 13 456 789</a>
            </div>
        </div>
    </div>
    <div class="navbar container">
        <a class="brand" href="https://outboundholiday.com/">
            <img src="https://outboundholiday.com/wp-content/themes/outbound-holidays/assets/logo/outbound-holidays-logo.webp" alt="Outbound Holidays" />
        </a>
        <nav class="main-menu" aria-label="Main navigation">
            <ul class="menu-list"><li><a href="https://outboundholiday.com/things-to-do-in-victoria-falls/">Experiences</a></li><li><a href="https://outboundholiday.com/victoria-falls-accommodation/">Accommodation</a></li><li><a href="https://outboundholiday.com/victoria-falls-packages/">Packages</a></li><li><a href="https://outboundholiday.com/victoria-falls-guide/">Guide</a></li><li><a href="https://outboundholiday.com/about/">About</a></li><li><a href="https://outboundholiday.com/contact/">Contact</a></li></ul>        </nav>
        <div class="header-actions">
            <button class="search-trigger" type="button" aria-label="Open search">Search</button>
            <a class="primary-btn" href="https://outboundholiday.com/contact/">Enquire now</a>
        </div>
    </div>
</header>
<div class="site-search-panel hidden" aria-live="polite">
    <div class="container search-panel-inner">
        <label class="search-field">
            <span>Search</span>
            <input type="search" id="global-search-input" placeholder="Search experiences, stays, packages..." />
            <button type="button" class="search-clear" aria-label="Clear search">✕</button>
        </label>
        <div id="global-search-results" class="search-results"></div>
    </div>
</div>
<main class="page-shell page-shell--narrow">
    <section class="section-block">
        <div class="container container-narrow text-center">
            <span class="eyebrow accent">404</span>
            <h1>This page does not exist</h1>
            <p>The route you are looking for may have moved or the page may not exist anymore.</p>
            <a class="primary-btn" href="https://outboundholiday.com/">Back home</a>
        </div>
    </section>
</main>
<footer class="site-footer">
    <div class="container footer-grid">
        <div>
            <h3>Outbound Holidays</h3>
            <p>Tailor-made Victoria Falls escapes, hospitality-led journeys and expert local planning.</p>
        </div>
        <div>
            <h4>Explore</h4>
            <ul>
                <li><a href="https://outboundholiday.com/things-to-do-in-victoria-falls/">Things to do</a></li>
                <li><a href="https://outboundholiday.com/victoria-falls-accommodation/">Accommodation</a></li>
                <li><a href="https://outboundholiday.com/victoria-falls-packages/">Packages</a></li>
                <li><a href="https://outboundholiday.com/travel-insights/">Travel insights</a></li>
            </ul>
        </div>
        <div>
            <h4>Contact</h4>
            <ul>
                <li><a href="mailto:hello@outboundholiday.com">hello@outboundholiday.com</a></li>
                <li><a href="tel:+263 13 456 789">+263 13 456 789</a></li>
                <li>Victoria Falls, Zimbabwe</li>
            </ul>
        </div>
    </div>
    <div class="container footer-bottom">
        <span>© 2026 Outbound Holidays</span>
        <form id="newsletter-form" class="newsletter-form">
            <input type="email" id="newsletter-email" placeholder="Enter email address" aria-label="Email address" required />
            <button type="submit">Subscribe</button>
        </form>
    </div>
</footer>
<div class="modal hidden" id="enquiry-modal" aria-modal="true" role="dialog">
    <div class="modal-backdrop" data-close-modal="true"></div>
    <div class="modal-card">
        <button class="modal-close" type="button" aria-label="Close">×</button>
        <h3>Plan your trip</h3>
        <form id="enquiry-form">
            <input type="text" name="name" placeholder="Your name" required />
            <input type="email" name="email" placeholder="Email" required />
            <input type="tel" name="phone" placeholder="Phone" />
            <textarea name="message" placeholder="Tell us about your trip"></textarea>
            <button type="submit" class="primary-btn">Send enquiry</button>
        </form>
    </div>
</div>
