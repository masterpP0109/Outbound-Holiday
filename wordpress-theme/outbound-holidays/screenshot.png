var OUTBOUND_DATA = {"homeUrl":"https://outboundholiday.com/","ajaxUrl":"https://outboundholiday.com/wp-admin/admin-ajax.php","siteName":"Outbound Holiday","searchIndex":{"experiences":[{"id":"guided-tour-of-the-falls","slug":"guided-tour-of-the-falls","title":"Guided Tour of the Falls","price":85,"currency":"USD","duration":"3 hours","category":"first-visit","category_tags":["first-visit","river"],"short_description":"An iconic introduction to the falls with a local guide.","overview":"See the main viewpoints, learn the history and geology of Victoria Falls, and enjoy sweeping vistas from the best lookout points.","why_we_recommend":"The ideal way to orient yourself and get the best photo moments in one walk.","featured_image":"https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=1200&q=80","gallery_layout":"grid","gallery":["https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=1200&q=80","https://images.unsplash.com/photo-1469474968028-56623f02e42e?auto=format&fit=crop&w=1200&q=80","https://images.unsplash.com/photo-1476514525535-07fb3b4ae5f1?auto=format&fit=crop&w=1200&q=80"],"highlights":["Local guide","Photo stops","Rainforest walk"],"whatsIncluded":["Guide","Entrance fees","Water refill"],"goodToKnow":["Wear non-slip footwear","Bring a light rain jacket"],"faqs":[{"q":"Is this suitable for families?","a":"Yes, the route is suitable for most ages and very popular with families."}],"relatedIds":["sunset-cruise","boma-dinner-show"]},{"id":"sunset-cruise","slug":"sunset-cruise","title":"Sunset Cruise","price":120,"currency":"USD","duration":"2.5 hours","category":"romance","category_tags":["river","couples"],"short_description":"Cruise the Zambezi with drinks, golden-hour views and relaxed dining.","overview":"Set on the river with sundowner drinks and a relaxed onboard atmosphere, this is a quintessential Victoria Falls evening.","why_we_recommend":"Perfect for couples, honeymooners or anyone wanting a softer-paced scenic experience.","featured_image":"https://images.unsplash.com/photo-1501785888041-af3ef285b470?auto=format&fit=crop&w=1200&q=80","gallery_layout":"featured","gallery":["https://images.unsplash.com/photo-1501785888041-af3ef285b470?auto=format&fit=crop&w=1200&q=80","https://images.unsplash.com/photo-1493246507139-91e8fad9978e?auto=format&fit=crop&w=1200&q=80","https://images.unsplash.com/photo-1527631746610-bca00a040d60?auto=format&fit=crop&w=1200&q=80"],"highlights":["Drinks included","Sunset views","Wildlife sightings"],"whatsIncluded":["Cruise ticket","Drinks","Transfer pickup"],"goodToKnow":["Bring a light layer for cooler evening breezes"],"faqs":[{"q":"Can I book this for a romantic occasion?","a":"Absolutely, it's one of the most popular choices for couples and celebrations."}],"relatedIds":["guided-tour-of-the-falls","boma-dinner-show"]},{"id":"boma-dinner-show","slug":"boma-dinner-show","title":"Boma Dinner & Show","price":145,"currency":"USD","duration":"4 hours","category":"culture","category_tags":["culture","night-life"],"short_description":"A vibrant African feast with music, dance and local storytelling.","overview":"Experience a traditional Boma evening with a selection of Zimbabwean dishes, drums, dance and striking cultural performances.","why_we_recommend":"It combines great food, atmosphere and local culture in one memorable evening.","featured_image":"https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?auto=format&fit=crop&w=1200&q=80","gallery_layout":"carousel","gallery":["https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?auto=format&fit=crop&w=1200&q=80","https://images.unsplash.com/photo-1522202176988-66273c2fd55f?auto=format&fit=crop&w=1200&q=80","https://images.unsplash.com/photo-1529156069898-49953e39b3ac?auto=format&fit=crop&w=1200&q=80"],"highlights":["Traditional dinner","Live entertainment","Cultural experience"],"whatsIncluded":["Dinner","Cultural show","Welcome drink"],"goodToKnow":["Booking ahead is recommended for peak season"],"faqs":[{"q":"Does the venue suit mixed groups?","a":"Yes, it works well for families, friends and couples alike."}],"relatedIds":["guided-tour-of-the-falls","sunset-cruise"]}],"accommodations":[{"id":"ilala-lodge","slug":"ilala-lodge","title":"Ilala Lodge","category":"luxury","price":230,"currency":"USD","rating":4.8,"review_count":662,"distance_from_falls":"1.4 km","featured_image":"https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?auto=format&fit=crop&w=1200&q=80","short_description":"Classic elegance and excellent access to the falls.","overview":"A beloved lodge with a strong sense of heritage and refined hospitality on the edge of Victoria Falls.","highlights":["River views","Pool","Easy access"],"reviews":[{"name":"A. Morris","quote":"A beautiful and easy stay in a fantastic location."}]},{"id":"batonka-guest-lodge","slug":"batonka-guest-lodge","title":"Batonka Guest Lodge","category":"budget","price":140,"currency":"USD","rating":4.7,"review_count":482,"distance_from_falls":"2.2 km","featured_image":"https://images.unsplash.com/photo-1520250497591-112f2f40a3f4?auto=format&fit=crop&w=1200&q=80","short_description":"Great value for travellers who want comfort and convenience.","overview":"A comfortable, well-positioned base for visitors looking for dependable amenities and friendly local service.","highlights":["Pool","Breakfast","Family-friendly"],"reviews":[{"name":"S. Powell","quote":"Friendly service and a very convenient location."}]}],"packages":[{"id":"classic-falls-break","slug":"classic-falls-break","title":"Classic Falls Break","price":815,"currency":"USD","duration":"4 Days","badge":"Popular","intro":"A balanced introduction to the falls with accommodation, experiences and transfers included.","inclusions":["3 nights stay","Falls entrance","Sunset cruise","Airport transfer"],"featured_image":"https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=1200&q=80"},{"id":"luxury-zambezi-sojourn","slug":"luxury-zambezi-sojourn","title":"Luxury Zambezi Sojourn","price":1825,"currency":"USD","duration":"6 Days","badge":"Luxury","intro":"A premium escape combining river views, included activities and refined lodge stays.","inclusions":["Lodge stay","Private transfers","Boma dinner","Spa treatment"],"featured_image":"https://images.unsplash.com/photo-1501785888041-af3ef285b470?auto=format&fit=crop&w=1200&q=80"}],"blogs":[{"id":"best-time-to-visit-victoria-falls","slug":"best-time-to-visit-victoria-falls","title":"Best Time to Visit Victoria Falls","excerpt":"A practical guide to planning around water levels, weather and crowds.","reading_time":"6 min read","author":"Outbound Holidays Team","featured_image":"https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=1200&q=80","content":"Victoria Falls is exceptional year-round, but the best time depends on what you want to experience. The dry season is ideal for walking trails and game viewing, while the high-water season delivers spectacular spray and the biggest cascades."},{"id":"family-guide-to-victoria-falls","slug":"family-guide-to-victoria-falls","title":"Family Guide to Victoria Falls","excerpt":"Top family-friendly stays, activities and how to keep travel smooth.","reading_time":"5 min read","author":"Outbound Holidays Team","featured_image":"https://images.unsplash.com/photo-1476514525535-07fb3b4ae5f1?auto=format&fit=crop&w=1200&q=80","content":"Families often enjoy a blend of gentle walking routes, splash-friendly experiences and scenic river activities. Choosing a lodge near town makes daily logistics far simpler."}]},"landing":{"hero":[{"title":"Victoria Falls, Tailored to You","subtitle":"Crafted escapes for adventure, romance, wildlife and slow luxury.","image":"https://images.unsplash.com/photo-1544735716-392feef3d3f4?auto=format&fit=crop&w=1600&q=80"},{"title":"Sunrise on the Zambezi","subtitle":"River cruises, sunset dinners and immersive safari experiences.","image":"https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=1600&q=80"},{"title":"Wild journeys, easy planning","subtitle":"From first-time explorers to luxury honeymoons and family escapes.","image":"https://images.unsplash.com/photo-1476514525535-07fb3b4ae5f1?auto=format&fit=crop&w=1600&q=80"}],"trust_badges":[{"label":"25+ years planning trips","value":"25+"},{"label":"4.9 guest rating","value":"4.9/5"},{"label":"Tailor-made itineraries","value":"100%"}],"category_cards":[{"title":"Adventure","slug":"adventure","image":"https://images.unsplash.com/photo-1527631746610-bca00a040d60?auto=format&fit=crop&w=900&q=80"},{"title":"Wildlife","slug":"wildlife","image":"https://images.unsplash.com/photo-1547036967-23d11aacaee0?auto=format&fit=crop&w=900&q=80"},{"title":"Luxury","slug":"luxury","image":"https://images.unsplash.com/photo-1502920514313-52581002a659?auto=format&fit=crop&w=900&q=80"}],"promotional_banners":[{"title":"Flight + Stay bundles","copy":"Save on curated Victoria Falls escapes with stay-and-fly packages.","cta":"Explore Packages"}]},"site":{"common/Header.text1":"Victoria Falls Specialist","common/Header.text2":"Honest local guidance for holidays planned with confidence","common/Header.text13":"Plan My Holiday","common/Newsletter.text1":"Victoria Falls Travel Club","common/Newsletter.text2":"Stay Connected With Victoria Falls","common/Footer.text2":"Outbound Holidays"}};
