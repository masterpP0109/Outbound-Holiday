# Backend on Render only. Never expose secrets through VITE_*.
DATABASE_URL="postgresql://USER:PASSWORD@NEON-POOLER/HOST_DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@NEON-DIRECT/HOST_DATABASE?sslmode=require"
PORT=3002
APP_URL="https://YOUR-FRONTEND.vercel.app"
ALLOWED_ORIGINS="https://YOUR-FRONTEND.vercel.app"
API_PUBLIC_BASE_URL="https://YOUR-API.onrender.com/api/v1"
TRUST_PROXY_HOPS=1
CRON_SECRET=""
# Keep disabled until exact Namecheap product/sender and test recipient are confirmed.
EMAIL_PROVIDER=disabled
EMAIL_DELIVERY_MODE=disabled
EMAIL_TEST_TO=""
EMAIL_FROM=""
TEAM_ENQUIRY_TO=""
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_MESSAGE_ID_DOMAIN=""
# disabled, self-hosted (SMTP confirmation links), or optional brevo adapter
NEWSLETTER_PROVIDER=disabled
RESEND_API_KEY=""
BREVO_API_KEY=""
BREVO_LIST_ID=""
BREVO_DOI_TEMPLATE_ID=""
NEWSLETTER_WEBHOOK_SECRET=""
TURNSTILE_SECRET_KEY=""
ALLOW_REMOTE_BACKEND_TESTS=false
# Frontend Vercel build: public API endpoint only. Prerender must reach the API.
VITE_API_BASE_URL="https://YOUR-API.onrender.com/api/v1"
PRERENDER_API_BASE_URL="https://YOUR-API.onrender.com/api/v1"
VITE_TURNSTILE_SITE_KEY=""

# Local trusted WebP uploader only; obtain from neon env pull. Never VITE variables.
AWS_ENDPOINT_URL_S3=""
AWS_REGION="us-east-2"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# Docker boot migration/import (default true).
MIGRATE_ON_START=true
